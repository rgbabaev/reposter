[Unit]
Description=Personal Telegram Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitor
Group=monitor
WorkingDirectory=/opt/personal-monitor
Environment=MONITOR_CONFIG=/srv/personal-monitor/config.json
# Set this to the installed Node.js 24.19.0 binary.
ExecStart=/usr/bin/node /opt/personal-monitor/server/dist/index.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/personal-monitor/data

[Install]
WantedBy=multi-user.target
